# ===== 必填 =====

# 数据库连接地址（服务器上已有的 PostgreSQL）
# 登录服务器后运行下面的命令来找到连接信息
DATABASE_URL=postgresql://用户名:密码@主机地址:5432/数据库名

# JWT 密钥，在服务器上运行: openssl rand -hex 32 生成一个
JWT_SECRET_KEY=change-this

# ===== 选填 =====

# 前端端口，默认 80
PORT=80

# 前端访问地址（浏览器里打开的域名或IP）
CORS_ORIGINS=http://你的服务器IP或域名

# AI 分析（火山方舟），不填则自动回退到 mock 模式
AI_API_KEY=
ARK_API_KEY=

# AI image generation/editing (Volcengine Ark Seedream)
IMAGE_GENERATION_ENABLED=true
IMAGE_API_KEY=
IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_MODEL=doubao-seedream-5-0-260128
IMAGE_SIZE=2K
IMAGE_TIMEOUT_SECONDS=120
IMAGE_WATERMARK=false

# Daily photography inspiration (keep real credentials only in server .env)
UNSPLASH_ACCESS_KEY=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
INSPIRATION_DAILY_COUNT=4
INSPIRATION_RECENT_EXCLUSION_DAYS=14
INSPIRATION_ADMIN_EMAILS=
INSPIRATION_SYNC_ENABLED=true
INSPIRATION_SYNC_INTERVAL_HOURS=168
INSPIRATION_SYNC_PER_TOPIC=20
INSPIRATION_SYNC_STARTUP_DELAY_SECONDS=15
INSPIRATION_SYNC_TOPICS=portrait,landscape,street photography,architecture,still life,night photography,animals
