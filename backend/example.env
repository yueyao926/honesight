# Copy this file to backend/.env and fill in your own local values.
# Never commit backend/.env.

DATABASE_URL=postgresql://postgres:your-password@localhost:5432/HoneSight
JWT_SECRET_KEY=change-this-to-a-random-local-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads

# AI mode:
# - api: call your configured vision model provider
# - mock: use local mock analyzer, no external API required
AI_ANALYSIS_MODE=api
AI_ANALYSIS_ENABLED=true

# OpenAI-compatible vision model provider.
# For Volcengine Ark, use your inference endpoint ID (ep-...) from the console:
# AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# AI_MODEL=ep-xxxxxxxxxx-xxxxx
AI_API_KEY=replace-with-your-own-api-key
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_MODEL=doubao-seed-1-6-vision-250815
AI_FAST_MODEL=doubao-seed-2-0-lite-260215
AI_FAST_TIMEOUT_SECONDS=8
AI_TIMEOUT_SECONDS=45

# Backward-compatible Ark aliases used by older local code paths.
ARK_API_KEY=replace-with-your-own-api-key
ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3/responses
ARK_VISION_MODEL=doubao-seed-1-6-vision-250815

# Daily photography inspiration. Keys stay on the backend only.
UNSPLASH_ACCESS_KEY=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
INSPIRATION_DAILY_COUNT=4
INSPIRATION_RECENT_EXCLUSION_DAYS=14
# Comma-separated account emails allowed to sync and moderate inspiration photos.
INSPIRATION_ADMIN_EMAILS=
INSPIRATION_SYNC_ENABLED=true
INSPIRATION_SYNC_INTERVAL_HOURS=168
INSPIRATION_SYNC_PER_TOPIC=20
INSPIRATION_SYNC_STARTUP_DELAY_SECONDS=15
INSPIRATION_SYNC_TOPICS=portrait,landscape,street photography,architecture,still life,night photography,animals

# Direct messaging and community search
MESSAGE_IMAGE_MAX_SIZE=8388608
MESSAGE_RATE_LIMIT=20
MESSAGE_REQUEST_DAILY_LIMIT=10
SEARCH_RESULT_LIMIT=24
SEARCH_SEMANTIC_ENABLED=false
EMBEDDING_PROVIDER=
TEXT_EMBEDDING_MODEL=
IMAGE_EMBEDDING_MODEL=
EMBEDDING_DIMENSION=0
IMAGE_CAPTION_ENABLED=false
