# ===== 邮箱验证 / 密码找回 =====
# 前端访问地址，用于生成验证/重置邮件里的链接
FRONTEND_BASE_URL=http://localhost:5173
# SMTP 配置；SMTP_HOST 留空时邮件只打印到后端日志（本地开发调试）
SMTP_HOST=
