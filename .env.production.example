# ===== 数据库 =====
DB_PASSWORD=change-this-to-a-strong-password

# ===== JWT =====
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production

# ===== 前端端口 =====
PORT=80

# ===== CORS（前端访问地址，多个用逗号分隔）=====
CORS_ORIGINS=http://localhost

# ===== AI 分析（火山方舟）=====
AI_ANALYSIS_MODE=api
AI_API_KEY=your-api-key-here
ARK_API_KEY=your-api-key-here

# ===== AI image generation/editing (Volcengine Ark Seedream) =====
IMAGE_GENERATION_ENABLED=true
# Falls back to AI_API_KEY, then ARK_API_KEY when empty
IMAGE_API_KEY=
IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_MODEL=doubao-seedream-5-0-260128
IMAGE_SIZE=2K
IMAGE_TIMEOUT_SECONDS=120
IMAGE_WATERMARK=false