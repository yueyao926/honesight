# ===== 数据库 =====
DB_PASSWORD=change-this-to-a-strong-password

# ===== JWT =====
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_TOKEN_REUSE_GRACE_SECONDS=30
SESSION_COOKIE_NAME=lenscoach_refresh
# Requires HTTPS. Use false only for an explicitly insecure local deployment.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

# ===== 前端端口 =====
FRONTEND_INTERNAL_PORT=18080

# ===== CORS（前端访问地址，多个用逗号分隔）=====
CORS_ORIGINS=http://localhost

# ===== AI 分析（火山方舟）=====
AI_ANALYSIS_MODE=api
AI_API_KEY=your-api-key-here
ARK_API_KEY=your-api-key-here
# 快速首屏与每周练习使用；必须支持图片理解
AI_FAST_MODEL=doubao-seed-2-0-lite-260215
# 快速首屏最多等待秒数；超时后继续后台深度分析
AI_FAST_TIMEOUT_SECONDS=8
# 可选：单独覆盖每周练习模型；留空则沿用 AI_FAST_MODEL
AI_PRACTICE_MODEL=
# 公网 API 根地址，用于生成给视觉模型读取的短时签名图片链接
# Optional: only set this when /api/upload/ai-media is publicly reachable by the AI provider.
# Leave blank to send compressed images directly in the AI request (the safer default).
AI_PUBLIC_API_BASE_URL=
# 相同图片与分析参数的结果缓存时长
ANALYSIS_CACHE_TTL_HOURS=720
UPLOAD_CLEANUP_ENABLED=true
UPLOAD_CLEANUP_INTERVAL_HOURS=12
UPLOAD_CLEANUP_STARTUP_DELAY_SECONDS=30
ANALYSIS_IMAGE_RETENTION_HOURS=72
GENERATED_IMAGE_RETENTION_HOURS=168
PRACTICE_IMAGE_RETENTION_DAYS=30
ORPHAN_IMAGE_RETENTION_HOURS=72

# ===== AI image generation/editing (Volcengine Ark Seedream) =====
IMAGE_GENERATION_ENABLED=true
# Falls back to AI_API_KEY, then ARK_API_KEY when empty
IMAGE_API_KEY=
IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_MODEL=doubao-seedream-5-0-260128
IMAGE_SIZE=2K
IMAGE_TIMEOUT_SECONDS=120
IMAGE_WATERMARK=false

# Daily photography inspiration (keep real credentials only in server .env)
UNSPLASH_ACCESS_KEY=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
INSPIRATION_DAILY_COUNT=4
INSPIRATION_RECENT_EXCLUSION_DAYS=14
INSPIRATION_ADMIN_EMAILS=
INSPIRATION_SYNC_ENABLED=true
INSPIRATION_SYNC_INTERVAL_HOURS=168
INSPIRATION_SYNC_PER_TOPIC=20
INSPIRATION_SYNC_STARTUP_DELAY_SECONDS=15
INSPIRATION_SYNC_TOPICS=portrait,landscape,street photography,architecture,still life,night photography,animals

# Public contact address shown on the website
CONTACT_EMAIL=
